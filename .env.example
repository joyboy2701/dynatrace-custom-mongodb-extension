# Used for dt-sdk upload only (laptop) — not stored on the ActiveGate.
# Token must be a Dynatrace API access token with scopes:
#   extensions.write   (required - upload)
#   extensions.read    (recommended - verify/list)
DT_ENV_URL=https://your-tenant.live.dynatrace.com
DT_API_TOKEN=dt0c01.your_token_with_extensions_write_scope
